---
import { form } from '../data/content';
import { site } from '../data/site';
---

<form class="lf" id="modulo" method="post" action="#modulo" data-form novalidate>
  <div class="hp" aria-hidden="true"><label>Lascia vuoto <input name="hp_url" type="text" tabindex="-1" autocomplete="off" /></label></div>

  <fieldset class="lf-chips" data-chips>
    <legend>{form.interestLabel}</legend>
    <div class="chips">
      {form.interests.map((o) => <button type="button" class="chip" aria-pressed="false" data-value={o}>{o}</button>)}
    </div>
  </fieldset>

  <div class="lf-grid">
    <label class="fld"><span>{form.name}</span><input name="name" type="text" autocomplete="name" required maxlength="120" /></label>
    <label class="fld"><span>{form.phone}</span><input name="phone" type="tel" inputmode="tel" autocomplete="tel" required maxlength="40" /></label>
    <label class="fld"><span>{form.email}</span><input name="email" type="email" autocomplete="email" maxlength="200" /></label>
    <label class="fld"><span>{form.town}</span><input name="town" type="text" autocomplete="address-level2" maxlength="120" /></label>
  </div>
  <label class="fld fld--wide"><span>{form.message}</span><textarea name="message" rows="3" maxlength="2000"></textarea></label>

  <label class="consent">
    <input type="checkbox" name="privacy_consent" required />
    <span>{form.consent} <a href={site.privacyUrl} target="_blank" rel="noopener">Informativa</a></span>
  </label>

  <p class="lf-status" role="status" aria-live="polite" hidden data-status data-ok={form.thanks} data-err={form.error}></p>
  <button class="btn btn--paper btn--lg" type="submit" data-submit>{form.submit}</button>
  <noscript><p class="lf-status">Per inviare la richiesta serve JavaScript. Chiamaci allo {site.phone}.</p></noscript>
</form>

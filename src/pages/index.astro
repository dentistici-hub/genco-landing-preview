---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import LeadForm from '../components/LeadForm.astro';
import { site, nav } from '../data/site';
import { media } from '../data/media';
import { isPreview } from '../lib/url';
import { hero, proof, products, videos, qcSteps, steps, why, faq, form } from '../data/content';

const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Buongiorno, vorrei un preventivo per persiane, pergole, vetrate o finestre.')}`;
const year = new Date().getFullYear();
// Same rule as the banner: only offer cookie settings when there is a tracker to consent to (always in dev).
const hasTracking = Boolean(site.ga4Id || site.metaPixelId) || import.meta.env.DEV;

// Absolute URLs of the optimized photos, for the schema.org Service images.
const images: Record<string, string[]> = {};
for (const p of products) {
  const keys = [p.main, ...p.more].slice(0, 3);
  images[p.id] = await Promise.all(
    keys.map(async (k) => new URL((await getImage({ src: media[k].src, format: 'webp', width: 1200 })).src, site.url).toString()),
  );
}
const heroSizes = '(min-width: 900px) 540px, 92vw';
const mainSizes = '(min-width: 900px) 560px, 92vw';
const thumbSizes = '(min-width: 900px) 280px, 46vw';
---

<Base images={images}>
  {isPreview && <div class="ribbon">Anteprima del progetto per il cliente: contenuti, dominio e modulo sono provvisori.</div>}
  <header class="hdr" data-header>
    <div class="wrap hdr__in">
      <a class="logo" href="#top" aria-label={`${site.brand}, torna in alto`}>
        <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><rect width="32" height="32" rx="8" fill="currentColor"/><g fill="var(--accent)"><rect x="6" y="8" width="20" height="3" rx="1.5"/><rect x="6" y="13" width="20" height="3" rx="1.5" opacity=".8"/><rect x="6" y="18" width="20" height="3" rx="1.5" opacity=".6"/><rect x="6" y="23" width="20" height="3" rx="1.5" opacity=".4"/></g></svg>
        <span>{site.brand}</span>
      </a>
      <nav class="nav" aria-label="Sezioni">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
      <div class="hdr__cta">
        <a class="hdr__tel" href={`tel:${site.phoneHref}`}>{site.phone}</a>
        <a class="btn btn--primary btn--sm" href="#preventivo">Preventivo</a>
      </div>
    </div>
  </header>

  <main id="main">
    <section class="hero" id="top">
      <div class="wrap hero__in">
        <div class="hero__copy">
          <p class="kicker kicker--light" data-reveal>{hero.kicker}</p>
          <h1 data-reveal>{hero.h1}</h1>
          <p class="lead" data-reveal>{hero.lead}</p>
          <div class="hero__actions" data-reveal>
            <a class="btn btn--primary btn--lg" href="#preventivo">{hero.primary}</a>
            <a class="btn btn--ghost btn--lg" href={wa} target="_blank" rel="noopener">{hero.secondary}</a>
          </div>
          <ul class="hero__chips" data-reveal>
            {hero.chips.map((c) => <li>{c}</li>)}
          </ul>
        </div>
        <div class="hero__art" data-reveal>
          <Pic k="pergolaGiardino" sizes={heroSizes} eager />
        </div>
      </div>
      <div class="wrap">
        <nav class="hero__cards" aria-label="Prodotti">
          {products.map((p) => (
            <a class="pcard" href={`#${p.id}`} data-reveal>
              <span class="pcard__k">{p.kicker}</span>
              <span class="pcard__t">{p.teaser}</span>
              <span class="pcard__go" aria-hidden="true">→</span>
            </a>
          ))}
        </nav>
      </div>
    </section>

    <section class="proof" aria-label="Dati principali">
      <div class="wrap proof__grid">
        {proof.map((p) => (
          <div class="stat" data-reveal>
            <strong>{p.value}</strong>
            <span>{p.label}</span>
          </div>
        ))}
      </div>
    </section>

    {products.map((p, i) => (
      <section class={`product ${i % 2 ? 'product--flip' : 'product--alt'}`} id={p.id} aria-labelledby={`${p.id}-h`}>
        <div class="wrap product__in">
          <div class="product__media">
            <figure class="fig fig--main" data-reveal>
              <Pic k={p.main} sizes={mainSizes} />
              {media[p.main].caption && <figcaption>{media[p.main].caption}</figcaption>}
            </figure>
            {p.more.length > 0 && (
              <div class={`fig-grid ${p.more.length % 2 ? 'fig-grid--lead' : ''}`}>
                {p.more.map((k) => (
                  <figure class="fig" data-reveal>
                    <Pic k={k} sizes={thumbSizes} />
                    {media[k].caption && <figcaption>{media[k].caption}</figcaption>}
                  </figure>
                ))}
              </div>
            )}
          </div>
          <div class="product__copy">
            <p class="kicker" data-reveal>{p.kicker}</p>
            <h2 id={`${p.id}-h`} data-reveal>{p.h2}</h2>
            {p.paras.map((t) => <p data-reveal>{t}</p>)}
            <table class="spec" data-reveal>
              <caption class="sr">{p.specsCaption}</caption>
              <tbody>
                {p.specs.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}
              </tbody>
            </table>
            <a class="btn btn--dark" href="#preventivo" data-interest={p.interest} data-reveal>{p.cta}</a>
          </div>
        </div>

        {p.groups && (
          <div class="wrap groups">
            {p.groups.map((g) => (
              <article class="group" data-reveal>
                <h3>{g.title}</h3>
                {g.text && <p>{g.text}</p>}
                {g.specs && (
                  <table class="spec spec--sm">
                    <caption class="sr">{g.specsCaption}</caption>
                    <tbody>
                      {g.specs.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}
                    </tbody>
                  </table>
                )}
              </article>
            ))}
          </div>
        )}

        {p.id === 'finestre' && (
          <div class="wrap qc">
            <div class="qc__head">
              <h3 data-reveal>Come viene controllata una finestra Inversa</h3>
              <p data-reveal>Prima della consegna Biemme Finestre fa passare ogni finestra da sei controlli, che il produttore mostra in video.</p>
              <ol class="qc__steps">
                {qcSteps.map((s, n) => (
                  <li data-reveal><span>{String(n + 1).padStart(2, '0')}</span><div><strong>{s.t}</strong><p>{s.d}</p></div></li>
                ))}
              </ol>
            </div>
            <div class="qc__videos">
              {videos.map((v) => (
                <article class="vid" id={`video-${v.id}`} data-reveal>
                  <video controls preload="none" playsinline poster={v.poster} aria-label={v.title}>
                    <source src={v.src} type="video/mp4" />
                    <track kind="captions" srclang="it" label="Italiano" src={v.captions} />
                  </video>
                  <h4>{v.title}</h4>
                  <p>{v.description} Durata: {v.label}.</p>
                  <details>
                    <summary>Leggi la trascrizione</summary>
                    <p>{v.transcript}</p>
                  </details>
                </article>
              ))}
            </div>
          </div>
        )}
      </section>
    ))}

    <section class="process" id="come-lavoriamo" aria-labelledby="proc-h">
      <div class="wrap">
        <p class="kicker" data-reveal>Come lavoriamo</p>
        <h2 id="proc-h" data-reveal>Dalla prima foto alla posa, in quattro passaggi.</h2>
        <ol class="steps">
          {steps.map((s) => (
            <li class="step" data-reveal>
              <span class="step__n">{s.n}</span>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="why" aria-labelledby="why-h">
      <div class="wrap why__in">
        <div>
          <p class="kicker kicker--light" data-reveal>Perché Genco</p>
          <h2 id="why-h" data-reveal>Una sola azienda dal sopralluogo al post vendita.</h2>
        </div>
        <div class="why__list">
          {why.map((w) => (
            <article class="why__item" data-reveal>
              <h3>{w.t}</h3>
              <p>{w.d}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="faq" id="domande" aria-labelledby="faq-h">
      <div class="wrap faq__in">
        <div class="faq__head">
          <p class="kicker" data-reveal>Domande frequenti</p>
          <h2 id="faq-h" data-reveal>Prima di chiedere il preventivo.</h2>
          <p data-reveal>Se la tua domanda non c'è, scrivici o chiamaci al <a href={`tel:${site.phoneHref}`}>{site.phone}</a>.</p>
        </div>
        <div class="faq__list">
          {faq.map((g) => (
            <div class="faq__group">
              <h3 data-reveal>{g.title}</h3>
              {g.items.map((f) => (
                <details class="qa" data-reveal>
                  <summary>{f.q}</summary>
                  <p>{f.a}</p>
                </details>
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="cta" id="preventivo" aria-labelledby="cta-h">
      <div class="wrap cta__in">
        <div class="cta__copy">
          <p class="kicker kicker--light" data-reveal>Preventivo</p>
          <h2 id="cta-h" data-reveal>{form.title}</h2>
          <p data-reveal>{form.intro}</p>
          <ul class="contact" data-reveal>
            <li><span>Telefono</span><a href={`tel:${site.phoneHref}`}>{site.phone}</a></li>
            <li><span>WhatsApp</span><a href={wa} target="_blank" rel="noopener">Scrivici per mandare le foto</a></li>
            <li><span>Zona</span>{site.area}</li>
          </ul>
        </div>
        <div class="cta__form" data-reveal><LeadForm /></div>
      </div>
    </section>
  </main>

  <footer class="ftr">
    <div class="wrap ftr__in">
      <p><strong>{site.legalName}</strong>{site.vat ? ` · P.IVA ${site.vat}` : ''}<br />{site.locality} ({site.region}) · <a href={`tel:${site.phoneHref}`}>{site.phone}</a></p>
      <p><a href={site.mainSiteUrl} rel="noopener">Tutto il catalogo Genco</a> · <a href={site.privacyUrl} rel="noopener">Privacy e cookie</a>{hasTracking && <> · <button type="button" class="linklike" data-consent-open>Gestisci cookie</button></>}</p>
      <p class="ftr__c">© {year} {site.legalName}. Marchi e prodotti Biemme Finestre, Gaviota e Visibilia appartengono ai rispettivi titolari.</p>
    </div>
  </footer>

  <div class="mbar" role="group" aria-label="Contatto rapido">
    <a class="btn btn--ghost-dark" href={`tel:${site.phoneHref}`}>Chiama</a>
    <a class="btn btn--primary" href="#preventivo">Richiedi preventivo</a>
  </div>
</Base>

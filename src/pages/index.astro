---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import LeadForm from '../components/LeadForm.astro';
import { site, nav } from '../data/site';
import { media } from '../data/media';
import { isPreview } from '../lib/url';
import { hero, intro, products, videos, qc, steps, about, faq, form } from '../data/content';

const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Buongiorno, vorrei un preventivo per persiane, pergole, vetrate o finestre.')}`;
const year = new Date().getFullYear();
// Same rule as the banner: only offer cookie settings when there is a tracker to consent to (always in dev).
const hasTracking = Boolean(site.ga4Id || site.metaPixelId) || import.meta.env.DEV;

// Absolute URLs of the optimized photos, for the schema.org Service images.
const images: Record<string, string[]> = {};
for (const p of products) {
  const keys = [p.main, ...p.more].slice(0, 3);
  images[p.id] = await Promise.all(
    keys.map(async (k) => new URL((await getImage({ src: media[k].src, format: 'webp', width: 1200 })).src, site.url).toString()),
  );
}
const num = (i: number) => String(i + 1).padStart(2, '0');
---

<Base images={images}>
  {isPreview && <div class="ribbon">Anteprima del progetto per il cliente: contenuti, dominio e modulo sono provvisori.</div>}

  <header class="hdr" data-header>
    <div class="wrap hdr__in">
      <a class="logo" href="#top" aria-label={`${site.brand}, torna in alto`}>{site.brand}</a>
      <nav class="nav" aria-label="Sezioni">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
      <div class="hdr__cta">
        <a class="hdr__tel" href={`tel:${site.phoneHref}`}>{site.phone}</a>
        <a class="hdr__tel hdr__tel--2" href={`tel:${site.phone2Href}`}>{site.phone2}</a>
        <a class="btn btn--line btn--sm" href="#preventivo">Preventivo</a>
      </div>
    </div>
  </header>

  <main id="main">
    <section class="hero" id="top">
      <div class="hero__bg"><Pic k="pergolaGiardino" sizes="100vw" eager /></div>
      <div class="wrap hero__in">
        <p class="kicker kicker--light">{hero.kicker}</p>
        <h1>{hero.line} <em>{hero.script}</em></h1>
        <p class="lead">{hero.lead}</p>
        <div class="hero__actions">
          <a class="btn btn--paper btn--lg" href="#preventivo">{hero.primary}</a>
          <a class="textlink textlink--light" href={wa} target="_blank" rel="noopener">{hero.secondary}</a>
        </div>
      </div>
    </section>

    <section class="intro" aria-labelledby="intro-h">
      <div class="wrap intro__in">
        <div>
          <p class="kicker">{intro.kicker}</p>
          <h2 id="intro-h" class="sr">Cosa fa Genco</h2>
          <p class="intro__text">{intro.text}</p>
        </div>
        <ol class="index">
          {products.map((p, i) => (
            <li>
              <a href={`#${p.id}`}>
                <span class="index__n">{num(i)}</span>
                <span class="index__t">{p.kicker}</span>
                <span class="index__d">{p.teaser}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {products.map((p, i) => (
      <section class={`prod ${i % 2 ? 'prod--alt' : ''}`} id={p.id} aria-labelledby={`${p.id}-h`}>
        <div class="wrap">
          <header class="prod__head">
            <p class="kicker">{num(i)} / {p.kicker}</p>
            <h2 id={`${p.id}-h`}>{p.h2}</h2>
          </header>

          <figure class="shot shot--wide">
            <Pic k={p.main} sizes="(min-width: 1200px) 1120px, 92vw" />
            {media[p.main].caption && <figcaption>{media[p.main].caption}</figcaption>}
          </figure>

          <div class="prod__cols">
            <div class="prod__text">
              {p.paras.map((t) => <p>{t}</p>)}
              <a class="textlink" href="#preventivo" data-interest={p.interest}>{p.cta}</a>
            </div>
            <table class="spec">
              <caption class="sr">{p.specsCaption}</caption>
              <tbody>
                {p.specs.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}
              </tbody>
            </table>
          </div>

          {p.more.length > 0 && (
            <ul class="strip" data-n={p.more.length}>
              {p.more.map((k) => (
                <li>
                  <figure class="shot">
                    <Pic k={k} sizes="(min-width: 900px) 270px, 46vw" />
                    {media[k].caption && <figcaption>{media[k].caption}</figcaption>}
                  </figure>
                </li>
              ))}
            </ul>
          )}

          {p.groups && (
            <div class="groups" data-n={p.groups.length}>
              {p.groups.map((g) => (
                <article class="group">
                  <h3>{g.title}</h3>
                  {g.text && <p>{g.text}</p>}
                  {g.specs && (
                    <table class="spec spec--sm">
                      <caption class="sr">{g.specsCaption}</caption>
                      <tbody>
                        {g.specs.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}
                      </tbody>
                    </table>
                  )}
                </article>
              ))}
            </div>
          )}

          {p.id === 'finestre' && (
            <div class="qc">
              <div class="qc__head">
                <h3>{qc.title}</h3>
                <p>{qc.text}</p>
                <ol class="qc__steps">
                  {qc.steps.map((s, n) => (
                    <li><span>{num(n)}</span><div><strong>{s.t}</strong><p>{s.d}</p></div></li>
                  ))}
                </ol>
              </div>
              <div class="qc__videos">
                {videos.map((v) => (
                  <article class="vid" id={`video-${v.id}`}>
                    <video controls preload="none" playsinline poster={v.poster} aria-label={v.title}>
                      <source src={v.src} type="video/mp4" />
                      <track kind="captions" srclang="it" label="Italiano" src={v.captions} />
                    </video>
                    <h4>{v.title}</h4>
                    <p>{v.description} Durata: {v.label}.</p>
                    <details>
                      <summary>Leggi la trascrizione</summary>
                      <p>{v.transcript}</p>
                    </details>
                  </article>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>
    ))}

    <section class="process" id="come-lavoriamo" aria-labelledby="proc-h">
      <div class="wrap">
        <p class="kicker">05 / Come si lavora</p>
        <h2 id="proc-h">Dalla prima foto alla posa.</h2>
        <ol class="steps">
          {steps.map((s) => (
            <li>
              <span class="steps__n">{s.n}</span>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="about" aria-labelledby="about-h">
      <div class="wrap about__in">
        <div>
          <p class="kicker kicker--light">{about.kicker}</p>
          <h2 id="about-h">{about.h2}</h2>
        </div>
        <div>
          <p>{about.text}</p>
          <a class="textlink textlink--light" href={site.mainSiteUrl} rel="noopener">{about.link}</a>
        </div>
      </div>
    </section>

    <section class="faq" id="domande" aria-labelledby="faq-h">
      <div class="wrap faq__in">
        <div class="faq__head">
          <p class="kicker">06 / Domande frequenti</p>
          <h2 id="faq-h">Prima di chiedere il preventivo.</h2>
          <p>Se la tua domanda non c'è, scrivici o chiama il <a href={`tel:${site.phoneHref}`}>{site.phone}</a> o il <a href={`tel:${site.phone2Href}`}>{site.phone2}</a>.</p>
        </div>
        <div class="faq__list">
          {faq.map((g) => (
            <div class="faq__group">
              <h3>{g.title}</h3>
              {g.items.map((f) => (
                <details class="qa">
                  <summary>{f.q}</summary>
                  <p>{f.a}</p>
                </details>
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="cta" id="preventivo" aria-labelledby="cta-h">
      <div class="wrap cta__in">
        <div class="cta__copy">
          <p class="kicker kicker--light">{form.kicker}</p>
          <h2 id="cta-h">{form.title}</h2>
          <p>{form.intro}</p>
          <ul class="contact">
            <li><span>Telefono</span><a href={`tel:${site.phoneHref}`}>{site.phone}</a> · <a href={`tel:${site.phone2Href}`}>{site.phone2}</a></li>
            <li><span>WhatsApp</span><a href={wa} target="_blank" rel="noopener">Scrivici per mandare le foto</a></li>
            <li><span>Zona</span>{site.area}</li>
          </ul>
        </div>
        <div class="cta__form"><LeadForm /></div>
      </div>
    </section>
  </main>

  <footer class="ftr">
    <div class="wrap ftr__in">
      <p><strong>{site.legalName}</strong>{site.vat ? ` · P.IVA ${site.vat}` : ''}<br />{site.street}, {site.postalCode} {site.locality} ({site.region}) · <a href={`tel:${site.phoneHref}`}>{site.phone}</a> · <a href={`tel:${site.phone2Href}`}>{site.phone2}</a></p>
      <p><a href={site.mainSiteUrl} rel="noopener">Catalogo completo</a> · <a href={site.privacyUrl} rel="noopener">Privacy e cookie</a>{hasTracking && <> · <button type="button" class="linklike" data-consent-open>Gestisci cookie</button></>}</p>
      <p class="ftr__c">© {year} {site.legalName}. I marchi Biemme Finestre e Gaviota appartengono ai rispettivi titolari.</p>
    </div>
  </footer>

  <div class="mbar" role="group" aria-label="Contatto rapido">
    <a class="btn btn--line" href={`tel:${site.phoneHref}`}>Chiama</a>
    <a class="btn btn--ink" href="#preventivo">Richiedi preventivo</a>
  </div>
</Base>
